# Variables que configuras en Azure (App Service → Configuración → Variables de entorno).
# NO subas un .env real a GitHub.
APP_NAME=FoodMatch
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:PEGA_AQUI_LA_DE_TU_.env_LOCAL
APP_URL=https://TU-APP.azurewebsites.net
APP_LOCALE=es

LOG_CHANNEL=stderr
SESSION_SECURE_COOKIE=true

# Base de datos (SQLite se guarda sola en la carpeta persistente; no necesitas más)
DB_CONNECTION=sqlite

# Azure: conservar archivos entre reinicios y puerto del contenedor
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true
WEBSITES_PORT=80

# Primera vez: cargar categorías y datos base (luego bórrala o ponla en 0)
RUN_SEED=1

# Correo real (Gmail con clave de aplicación)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=CLAVE_DE_APLICACION_DE_16_LETRAS
MAIL_FROM_ADDRESS=tucorreo@gmail.com
MAIL_FROM_NAME="FoodMatch"
